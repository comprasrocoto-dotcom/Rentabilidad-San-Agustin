# .env.example
# Plantilla de variables de entorno para el backend de San Agustin.
# NO pongas valores reales aqui. Copia estas claves en las Environment
# Variables de Vercel (Project Settings -> Environment Variables) y
# rellena los valores reales alli.

# Email de la cuenta de servicio de Google (termina en .iam.gserviceaccount.com)
GOOGLE_CLIENT_EMAIL=

# Clave privada de la cuenta de servicio.
# Pega el valor "private_key" del JSON tal cual, entre comillas.
# Los saltos de linea deben ir escapados como \n.
GOOGLE_PRIVATE_KEY=

# ID del Google Sheet a leer (obligatorio). Sin valor por defecto en el codigo.
SHEET_ID=
